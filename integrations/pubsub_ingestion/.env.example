# GCP / Pub/Sub
GCP_PROJECT_ID=CHANGE_ME
PUBSUB_FLINK_SUBSCRIPTION=CHANGE_ME
PUBSUB_GLUE_SUBSCRIPTION=CHANGE_ME

# Used automatically by the Google Cloud client library.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

LOG_LEVEL=INFO

# AWS placeholders for future HUs. Not used by this PoC yet.
AWS_REGION=CHANGE_ME
FLINK_APPLICATION_NAME=CHANGE_ME
GLUE_JOB_NAME=CHANGE_ME
DYNAMODB_TABLE_NAME=CHANGE_ME
S3_BRONZE_BUCKET=CHANGE_ME
S3_BRONZE_PREFIX=bronze/events/
